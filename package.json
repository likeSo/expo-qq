  "dependencies": {},
  "devDependencies": {
    "@types/react": "~19.0.0",
    "expo-module-scripts": "^4.1.9",
    "expo": "~53.0.0",
    "react-native": "0.79.1"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
